# ─────────────────────────────────────────────────────────────
# MoverOS environment variables — copy to .env.local and fill in.
# .env.local is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Supabase (DB + Auth + Storage) ──
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""                 # Drizzle (pooled Postgres connection string)

# ── Anthropic (agents) ──
ANTHROPIC_API_KEY=""

# ── Inngest (background jobs / agent orchestration) ──
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Nylas (send/receive email on user's behalf) ──
NYLAS_API_KEY=""
NYLAS_CLIENT_ID=""
NYLAS_CLIENT_SECRET=""
# Webhook secret from the Nylas dashboard (Webhooks → your endpoint). Inbound
# replies are rejected unless their HMAC signature verifies against this.
NYLAS_WEBHOOK_SECRET=""

# ── Stripe (one-time unlock + gifting) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Twilio (SMS — requires A2P 10DLC registration) ──
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Resend (transactional email) ──
RESEND_API_KEY=""

# ── External data APIs ──
GOOGLE_PLACES_API_KEY=""
SMARTYSTREETS_AUTH_ID=""
SMARTYSTREETS_AUTH_TOKEN=""

# ── Observability ──
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
